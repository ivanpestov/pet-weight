<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window theme used before Compose takes over. DeviceDefault.DayNight follows the system
         light/dark setting; the platform has no NoActionBar variant of it, so the action bar is
         switched off by hand. -->
    <style name="Theme.Weighly" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
