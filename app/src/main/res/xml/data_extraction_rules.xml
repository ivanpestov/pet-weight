<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-to-device transfer on API 31 and above. Only the Records database is carried;
   nothing else the app writes is worth restoring.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="weighly.db" />
    <include domain="database" path="weighly.db-wal" />
        <include domain="database" path="weighly.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="weighly.db" />
    <include domain="database" path="weighly.db-wal" />
        <include domain="database" path="weighly.db-wal" />
    </device-transfer>
</data-extraction-rules>
